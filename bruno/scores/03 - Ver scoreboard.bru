meta {
  name: Ver scoreboard
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/games/{{gameId}}/scores
  body: none
  auth: none
}

vars:pre-request {
  gameId: 4522a58a-1a6d-4cdc-b67d-a66e6890e5fd
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].playerName: eq Ana
  res.body[0].score: eq 10
  res.body[1].playerName: eq César
  res.body[1].score: eq 8
}
