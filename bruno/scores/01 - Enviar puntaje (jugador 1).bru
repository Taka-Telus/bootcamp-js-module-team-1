meta {
  name: Enviar puntaje (jugador 1)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/games/{{gameId}}/scores
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "playerName": "César",
    "score": 8
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.gameId: eq {{gameId}}
}
