meta {
  name: Crear juego
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/games
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Prueba Bruno",
    "author": "Bruno",
    "image": "https://picsum.photos/seed/quiz/400/300"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.questions: isArray
}

script:post-response {
  bru.setVar("gameId", res.body.id);
}
