meta {
  name: Editar una pregunta
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/games/{{gameId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "questions": [
      {
        "id": "{{questionId1}}",
        "text": "¿Quién salió campeón del Mundial 2022?",
        "options": ["Argentina", "Francia", "Marruecos", "Croacia"]
      },
      {
        "id": "{{questionId2}}",
        "text": "¿En qué países se juega el Mundial 2026?",
        "options": ["Estados Unidos, Canadá y México", "Qatar", "Rusia", "Brasil"]
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.questions: length 2
  res.body.questions[0].text: eq ¿Quién salió campeón del Mundial 2022?
}
