meta {
  name: Editar datos del juego
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/games/{{gameId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Prueba Bruno (editado)",
    "image": "https://picsum.photos/seed/quiz-editado/400/300"
  }
}

assert {
  res.status: eq 200
  res.body.title: eq Prueba Bruno (editado)
}
