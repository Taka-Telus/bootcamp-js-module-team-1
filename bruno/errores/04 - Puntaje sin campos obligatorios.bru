meta {
  name: Puntaje sin campos obligatorios
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/games/{{gameId}}/scores
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "playerName": "Sin puntaje"
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}
